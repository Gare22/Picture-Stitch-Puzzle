# Godot 4.2+ specific ignores
~*.dll

# Godot 4+ specific ignores
.godot/
.nomedia

# Godot export output
exports/

# Godot-specific ignores
.import/
export.cfg
export_credentials.cfg
*.tmp

# Imported translations (automatically generated from CSV files)
*.translation

# Mono-specific ignores
.mono/
data_*/
mono_crash.*.json

# Android gradle build artifacts (generated by Godot's Android export).
android/build/.gradle/
android/build/build/
android/build/libs/
# The exported build template under src/ is regenerable, EXCEPT the two files
# customized for the itch OAuth deep-link bridge, which are tracked project state:
android/build/src/
!android/build/src/main/
!android/build/src/main/AndroidManifest.xml
!android/build/src/main/java/
!android/build/src/main/java/com/
!android/build/src/main/java/com/godot/
!android/build/src/main/java/com/godot/game/
!android/build/src/main/java/com/godot/game/GodotApp.java
# Per-export game data is regenerated on every export.
android/build/src/main/assets/
android/build/assetPackInstallTime
